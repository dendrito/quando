rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Replace this placeholder with the Firebase Auth UID of the sole
    // authorized owner before deploying. Until then, access is denied.
    function isAuthorizedOwner() {
      return request.auth != null
        && request.auth.uid == 'REPLACE_WITH_OWNER_FIREBASE_AUTH_UID'
        && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow read, write: if isAuthorizedOwner() && request.auth.uid == userId;
    }

    // Explicit default deny for every other collection and document.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
